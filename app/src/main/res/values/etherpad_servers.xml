<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        NEXUS hardening baseline:
        Do not ship public Etherpad/CryptPad services as trusted defaults.
        A same-device Termux Etherpad endpoint is the only built-in option.
        Remote collaboration servers must be explicitly added by the user and
        are required by code/network policy to use HTTPS.
    -->
    <string-array name="etherpad_servers_name" translatable="false">
        <item>NEXUS Local (Termux)</item>
    </string-array>

    <string-array name="etherpad_servers_url_home" translatable="false">
        <item>http://localhost:9001</item>
    </string-array>

    <string-array name="etherpad_servers_url_padprefix" translatable="false">
        <item>http://localhost:9001/p/</item>
    </string-array>

    <string-array name="etherpad_servers_whitelist" translatable="false">
        <item>localhost</item>
    </string-array>

    <array name="etherpad_servers_cryptpad" translatable="false">
        <item>false</item>
    </array>
</resources>
